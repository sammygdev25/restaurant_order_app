# ─────────────────────────────────────────────────────────────
# Production Environment Variables
# Copy to .env.production and fill in real values
# NEVER commit this file with real secrets
# ─────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=                          ${SECRET_KEY:-changeme-in-production}
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Ports ────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=/api

# ── Docker Registry (for CI/CD) ──────────────────────────────
DOCKER_REGISTRY=                     # e.g., ghcr.io/your-org
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=WARNING
